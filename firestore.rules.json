{
  "rules_version": "2",
  "service": "cloud.firestore",
  "match": {
    "/databases/{database}/documents": {
      "workers": {
        ".read": "true",
        ".write": "false"
      },
      "reviews": {
        ".read": "true",
        ".write": "request.auth != null"
      },
      "workerBookings": {
        ".read": "request.auth != null && (resource.data.residentId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')",
        ".write": "request.auth != null && (request.resource.data.residentId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')"
      },
      "residents": {
        ".read": "request.auth != null && (resource.id == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')",
        ".write": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'"
      },

      "towers": {
        "$towerId": {
          ".read": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'",
          ".write": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'",

          "wings": {
            "$wingId": {
              ".read": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'",
              ".write": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'",

              "flats": {
                "$flatId": {
                  ".read": "request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || resource.data.residentId == request.auth.uid)",
                  ".write": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'"
                }
              }
            }
          }
        }
      }
    }
  }
}

